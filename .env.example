# Local container ports only. Do not put credentials in this file.
API_PORT=8080
SQL_PORT=1433
MSSQL_SA_PASSWORD=Your_password123

# Frontend runs outside Docker with pnpm; this is the browser origin allowed by the API.
FRONTEND_ORIGIN=http://localhost:3000

# Development account emails are captured in the API container's lca-development-mail volume.
# AccountRecovery limits and token lifetimes have secure application defaults and may be overridden here.
# ACCOUNT_RECOVERY_FORGOT_REQUESTS_PER_IP=5
# ACCOUNT_RECOVERY_FORGOT_WINDOW_MINUTES=15
# ACCOUNT_RECOVERY_TOKEN_ATTEMPTS_PER_IP=10
# ACCOUNT_RECOVERY_TOKEN_ATTEMPT_WINDOW_MINUTES=15
# ACCOUNT_RECOVERY_MINIMUM_EMAIL_INTERVAL_MINUTES=5
# ACCOUNT_RECOVERY_MAXIMUM_EMAILS_PER_HOUR=3
# ACCOUNT_RECOVERY_INITIAL_SETUP_TOKEN_HOURS=24
# ACCOUNT_RECOVERY_PASSWORD_RESET_TOKEN_MINUTES=60

# Supply secrets through environment variables or a secret manager; never commit them.
# ConnectionStrings__LcaDatabase=Server=localhost,1433;Database=Lca;User Id=sa;Password=Your_password123;TrustServerCertificate=True
# Authentication__Jwt__Issuer=
# Authentication__Jwt__Audience=
# Authentication__Jwt__SigningKey=
# Authentication__Jwt__AccessTokenMinutes=60

# Optional Development-only initial account provisioning. Use two distinct emails.
# InitialAccounts__PlatformEmail=
# InitialAccounts__PlatformPassword=
# InitialAccounts__TenantEmail=
# InitialAccounts__TenantPassword=
